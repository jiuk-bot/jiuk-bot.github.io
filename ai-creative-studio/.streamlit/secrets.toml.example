# 이 파일을 secrets.toml 로 복사해서 값을 채우세요 (secrets.toml 은 절대 깃에 올리지 않음)
# Streamlit Cloud 배포 시에는 앱 설정 > Secrets 에 아래 내용을 그대로 붙여넣습니다.

GEMINI_API_KEY = "여기에_Gemini_API_키"
GEMINI_MODEL   = "gemini-1.5-flash"   # 필요시 gemini-2.0-flash 등으로 변경

# 내부 전용 접근 비밀번호 (설정하면 앱 접속 시 비밀번호 요구 / 비워두면 공개)
APP_PASSWORD = "팀에_공유할_비밀번호"
