# 이 파일을 secrets.toml 로 복사해서 값을 채우세요 (secrets.toml 은 절대 깃에 올리지 않음)
# Streamlit Cloud 배포 시에는 앱 설정 > Secrets 에 아래 내용을 그대로 붙여넣습니다.

ANTHROPIC_API_KEY = "여기에_Claude_API_키"
CLAUDE_MODEL      = "claude-opus-4-8"   # 비용 아끼려면 claude-haiku-4-5 로 변경

# 내부 전용 접근 비밀번호 (설정하면 앱 접속 시 비밀번호 요구 / 비워두거나 줄 삭제하면 공개)
